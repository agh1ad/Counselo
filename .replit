modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "pnpm --filter @workspace/legal-site typecheck && pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/legal-site build && pnpm --filter @workspace/api-server build"
run = "PUBLIC_RESPONSE_CACHE_BACKEND=object-storage NODE_ENV=production pnpm --filter @workspace/api-server start"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CONTACT_OWNER_EMAIL = "bagdadio@gmail.com"
CONTACT_TEAM_EMAIL = "info@counselo-legal.com"
PUBLIC_SITE_URL = "https://counselo-legal.com"
CONTACT_FROM_EMAIL = "CounselO <consultations@counselo-legal.com>"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24438
externalPort = 3000
